# Neon PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@endpoint.aws.neon.tech/neondb?sslmode=require"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session cookie name is fixed in code. AUTH_SECRET is unused; sessions are random tokens stored in the database.
AUTH_SECRET="your-secure-random-secret"

# Login email. Production refuses to send codes until BREVO_API_KEY is set.
# MAIL_FROM must be a sender verified in the Brevo account.
# Local development shows the code on the login screen when the key is unset.
MAIL_FROM="Schoolites <noreply@schoolites.com>"
BREVO_API_KEY=""

# Neon Object Storage (S3 Protocol)
AWS_REGION="ap-southeast-1"
AWS_ENDPOINT_URL_S3="https://<account-id>.storage.neon.tech"
AWS_ACCESS_KEY_ID="your-neon-s3-access-key-id"
AWS_SECRET_ACCESS_KEY="your-neon-s3-secret-access-key"
AWS_BUCKET_NAME="storage-bucket"

GOOGLE_PLACES_API_KEY="your-google-places-api-key"