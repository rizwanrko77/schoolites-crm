# Neon PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@endpoint.aws.neon.tech/neondb?sslmode=require"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session & Auth Secret
AUTH_SECRET="your-secure-random-secret"

# Neon Object Storage (S3 Protocol)
AWS_REGION="ap-southeast-1"
AWS_ENDPOINT_URL_S3="https://<account-id>.storage.neon.tech"
AWS_ACCESS_KEY_ID="your-neon-s3-access-key-id"
AWS_SECRET_ACCESS_KEY="your-neon-s3-secret-access-key"
AWS_BUCKET_NAME="storage-bucket"

